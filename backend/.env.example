# ---------------------------------------------------------------------------
# RQMS backend configuration  (copy to .env)
# Defaults below match a fresh XAMPP install: MySQL/MariaDB on 3306, user
# "root", empty password.
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# --- Database (XAMPP MySQL / MariaDB) --------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rqms
DB_USERNAME=root
DB_PASSWORD=

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Idle session lifetime in minutes (cookie is refreshed while the user is active)
SESSION_LIFETIME=120
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Public employee self-registration on the login page (true/false)
# ALLOW_SIGNUP=true

# --- Frontend --------------------------------------------------------------
# Only needed if the React dev server calls the API directly instead of using
# the Vite proxy (the default). Comma separated list of allowed origins.
CLIENT_ORIGIN=http://localhost:5173

# --- Tunable domain rules (optional overrides) ------------------------------
# RQMS_W_ESSENTIAL=50
# RQMS_W_MEDICAL=30
# RQMS_W_SC=20
# RQMS_W_ST=20
# RQMS_W_OBC=10
# RQMS_W_GENERAL=0
# RQMS_W_SENIORITY_PER_YEAR=1
# RQMS_W_SENIORITY_CAP=15
# RQMS_W_APP_PER_MONTH=1
# RQMS_W_APP_CAP=10
# RQMS_RETENTION_DAYS=120
# RQMS_OVERSTAY_PENALTY=250
# RQMS_RETENTION_ALERT_DAYS=15

# --- Hosting (Hostinger etc.) -----------------------------------------------
# Instead of the DB_* values you can use one connection string:
# DATABASE_URL=mysql://dbuser:dbpassword@localhost:3306/dbname
#
# First run on a host without a shell: create tables + roles + the first super admin automatically.
# Remove ADMIN_PASSWORD from the environment after the first login.
# AUTO_BOOTSTRAP=true
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_NAME=Administrator
#
# Keep uploads/certificates outside the app folder if the host replaces it on redeploy:
# STORAGE_DIR=/home/youruser/rqms-storage
# Showcase deployments only: also create the demo accounts (password "password") + sample data.
# Pair with VITE_SHOW_DEMO=true when building the frontend to show the demo-login buttons.
# SEED_DEMO=true
