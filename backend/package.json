{
  "name": "rqms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Railway Quarter Management System (RQMS) - Express + MySQL API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/scripts/setup.js",
    "db:fresh": "node src/scripts/setup.js --fresh",
    "db:seed": "node src/scripts/seed.js",
    "db:admin": "node src/scripts/create-admin.js",
    "test": "node --test test/workflow.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
